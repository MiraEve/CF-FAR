<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FAFAFA">

    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态: 未运行"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#1A237E" />

    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="—"
        android:textColor="#00695C"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="链接"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCopyHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Header"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCopyCurl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="curl"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCopyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="链接=最短可点击（临时）· Header=长期使用 · curl=终端直连"
        android:textColor="#9E9E9E"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本地端口"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etLocalPort"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="目标"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="127.0.0.1 / 192.168.1.5"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTargetPort"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="5"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="令牌"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="访问令牌，留空=不校验（建议设置）"
            android:inputType="textVisiblePassword"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGenToken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="随机"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSelfTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="自检"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTokenState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="令牌: 未启用"
        android:textColor="#D50000"
        android:textSize="12sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbHeaderOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="仅 Header 鉴权（禁用 ?token= · 长期使用，防止令牌经 URL 泄露）"
        android:textColor="#1565C0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvHeaderOnlyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="○ 未运行"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="v1.12"
        android:textColor="#9E9E9E"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <RadioGroup
        android:id="@+id/rgProtocol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbHttp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="HTTP2 稳定"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rbQuic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUIC 加速"
            android:textSize="12sp" />
    </RadioGroup>

    </LinearLayout>

    <CheckBox
        android:id="@+id/cbUnlimited"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="无限攻击（关闭防爆破锁定，用于渗透测试）"
        android:textColor="#D50000"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvAuditAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFF3E0"
        android:padding="6dp"
        android:text="⚠ 无限攻击模式已开启：防爆破锁定已关闭，令牌错误可无限次尝试。取消勾选上方「无限攻击」即可恢复。"
        android:textColor="#EF6C00"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启动隧道" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="复制日志"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnShareLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导出日志"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清空"
            android:textSize="11sp" />
    </LinearLayout>


    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#FFEBEE"
        android:padding="6dp"
        android:textColor="#D50000"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="实时日志（点击下方按钮复制/导出）"
        android:textColor="#666666"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B2FF59"
            android:textIsSelectable="true"
            android:textSize="9sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>

